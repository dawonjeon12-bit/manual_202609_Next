# ── 필수 ──────────────────────────────────────────────
# Postgres (Neon / Supabase / 기타). Neon·Supabase는 풀링 URL을 DATABASE_URL에, 직결 URL을 DIRECT_URL에.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/modu?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/modu?sslmode=require"

# Auth.js — `npx auth secret` 으로 생성
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 서버 전용. 절대 NEXT_PUBLIC_ 접두를 붙이지 말 것.
ANTHROPIC_API_KEY=""

# ── 메일 ── 도입 문의를 dawonjeon12@gmail.com 으로 보낸다 (src/lib/mail.ts).
# 없으면 저장만 하고 완료 화면의 mailto 폴백으로 전달한다.
RESEND_API_KEY=""

# ── 권한 ──────────────────────────────────────────────
# 쉼표로 구분. 이 주소로 로그인하면 ADMIN 역할이 부여되어 /admin/inquiries 를 열람할 수 있다.
ADMIN_EMAILS="dawonjeon12@gmail.com"

# ── AI 모델 (비용 조정 시 claude-sonnet-5 로 변경 — 품질 판단은 운영자 몫) ──
ANTHROPIC_MODEL="claude-opus-5"
SITE_URL="https://your-domain.example"
