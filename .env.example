# 모든 값은 선택. 비워 두면 해당 기능만 꺼진다.

# ── 메일 ── 도입 문의를 dawonjeon12@gmail.com 으로 보낸다 (src/lib/mail.ts).
# 없으면 완료 화면의 mailto 폴백으로 전달한다.
RESEND_API_KEY=""

# ── AI 작성 기능 ── 서버 전용. 절대 NEXT_PUBLIC_ 접두를 붙이지 말 것.
# 로그인이 없어 사용자별 사용량 상한이 없다. 비용 상한은 Anthropic 콘솔에서 걸어 둘 것.
ANTHROPIC_API_KEY=""
# 비용 조정 시 claude-sonnet-5 로 변경 — 품질 판단은 운영자 몫
ANTHROPIC_MODEL="claude-opus-5"

# ── 도입 문의 저장 (Postgres) ── 없으면 저장하지 않고 메일만 보낸다.
DATABASE_URL=""
DIRECT_URL=""

SITE_URL="https://manual-202609-next.vercel.app"
